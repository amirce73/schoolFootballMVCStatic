@using Microsoft.AspNetCore.Identity
@inject UserManager<FootballSchool.Web.Models.ApplicationUser> UserManager
@{
    var _currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var _fullName = _currentUser != null && (!string.IsNullOrWhiteSpace(_currentUser.FirstName) || !string.IsNullOrWhiteSpace(_currentUser.LastName)) 
        ? $"{_currentUser.FirstName} {_currentUser.LastName}".Trim() 
        : (User.Identity?.Name ?? "کاربر گرامی");
    var _nationalId = !string.IsNullOrWhiteSpace(_currentUser?.NationalId) ? _currentUser.NationalId : "- - - - - - - - - -";
    var _birthDateStr = "- - / - - / - - - -";
    var _ageStr = "۰ سال";
    if (_currentUser?.BirthDate.HasValue == true)
    {
        var _bd = _currentUser.BirthDate.Value;
        var _pc = new System.Globalization.PersianCalendar();
        _birthDateStr = $"{_pc.GetYear(_bd):0000}/{_pc.GetMonth(_bd):00}/{_pc.GetDayOfMonth(_bd):00}";
        var _today = DateTime.Today;
        var _age = _today.Year - _bd.Year;
        if (_bd.Date > _today.AddYears(-_age)) _age--;
        _ageStr = $"{_age} سال";
    }
    var _joinDateStr = "- - - - / - - / - -";
    {
        var _cd = DateTime.Now;
        var _pc = new System.Globalization.PersianCalendar();
        _joinDateStr = $"{_pc.GetYear(_cd):0000}/{_pc.GetMonth(_cd):00}/{_pc.GetDayOfMonth(_cd):00}";
    }
    var _avatar = !string.IsNullOrWhiteSpace(_currentUser?.PassportPhotoPath) ? _currentUser.PassportPhotoPath : "/assets/images/messi-profile.jpg";
    var _currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    bool _isDashboard = _currentPath == "/dashboard" || _currentPath == "/dashboard.html";
    bool _isProfile = _currentPath.Contains("profile-hub") || _currentPath.Contains("personal-info") || _currentPath.Contains("contact-info") || _currentPath.Contains("passport-info") || _currentPath.Contains("clothing-info") || _currentPath.Contains("sports-info") || _currentPath.Contains("bank-info") || _currentPath.Contains("documents") || _currentPath.Contains("password") || _currentPath.Contains("verification");
    bool _isRegistration = _currentPath.Contains("registration");
    bool _isFinancial = _currentPath.Contains("financial");
    bool _isSpecialized = _currentPath.Contains("specialized") || _currentPath.Contains("attendance") || _currentPath.Contains("talent") || _currentPath.Contains("insurance") || _currentPath.Contains("certificate") || _currentPath.Contains("bulletin") || _currentPath.Contains("store") || _currentPath.Contains("gallery") || _currentPath.Contains("training-backpack") || _currentPath.Contains("club-info");
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - فوتبالیت" : "فوتبالیت - داشبورد مدرن")</title>
  <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <!-- Fullscreen invisible backdrop for closing profile menu on outside click -->
  <div id="profileMenuBackdrop" style="position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 99998; background: transparent; display: none;" onclick="closeProfileMenu();"></div>

  <div id="root">
    <!-- Top Navbar -->
    <nav class="top-navbar">
      <div class="navbar-container">
        <!-- Header Profile & Dropdown -->
        <div class="header-profile" id="headerProfileTrigger" style="cursor: pointer; position: relative; z-index: 99999;" onclick="toggleProfileMenu(event);">
          <div class="header-profile-avatar">
            <img alt="user" src="@_avatar" onerror="this.src='/assets/images/messi-profile.jpg';" />
          </div>
          <div>
            <div class="header-profile-info">
              <span class="name">@_fullName</span>
              <span class="meta">
                <i class="fa fa-calendar-check-o header-meta-icon"></i>عضویت:
                <strong class="dir-ltr header-meta-date">@_joinDateStr</strong>
              </span>
            </div>
          </div>
          <i class="fa fa-angle-down header-profile-arrow"></i>

          <div id="profileMenu" class="profile-menu" onclick="event.stopPropagation();">
            <div class="profile-menu-container">
              <div class="profile-menu-header">
                <div class="profile-menu-user-fullname">
                  @_fullName
                </div>
                <div class="profile-menu-verify-badge-wrap">
                  <a href="/verification">
                    <span class="badge-verify unverified">
                      <i class="fa fa-exclamation-circle"></i>استعلام هویت نشده
                    </span>
                  </a>
                </div>
              </div>
              <div class="profile-menu-info-row">
                <span>کد ملی:</span> <strong>@_nationalId</strong>
              </div>
              <div class="profile-menu-info-row">
                <span>تاریخ تولد:</span> <strong class="dir-ltr">@_birthDateStr</strong>
              </div>
              <div class="profile-menu-info-row">
                <span>سن:</span> <strong>@_ageStr</strong>
              </div>
              <div class="profile-menu-info-row no-margin">
                <span>رده سنی:</span> <strong>رده سنی جوانان</strong>
              </div>
            </div>

            <a href="/verification" class="profile-menu-verify-link"><i class="fa fa-shield"></i> تایید هویت و مدارک</a>
            <form id="logoutForm" method="post" action="/account/logout">
              @Html.AntiForgeryToken()
            </form>
            <a href="javascript:void(0)" class="profile-menu-logout-link">
              <i class="fa fa-sign-out"></i> خروج از حساب
            </a>
          </div>
        </div>

        <div class="header-actions">
          <!-- Bulletin / Notifications Button -->
          <a href="/bulletin" class="btn-noti" title="اعلان‌ها">
            <i class="fa fa-bell-o"></i>
            <span class="badge">۳</span>
          </a>
          <a href="#" class="btn-app-header" title="دانلود اپلیکیشن">
            <i class="fa fa-android"></i> <span>دانلود اپ</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Desktop Sidebar -->
    <aside class="desktop-sidebar">
      <div class="sidebar-title">
        منوی اصلی
      </div>
      <a class="dnav-item @(_isDashboard ? "active" : "")" href="/dashboard"><i class="fa fa-home"></i> خانه</a>
      <a class="dnav-item @(_isProfile ? "active" : "")" href="/profile-hub"><i class="fa fa-user"></i> پروفایل</a>
      <a class="dnav-item @(_isRegistration ? "active" : "")" href="/registration"><i class="fa fa-edit"></i> ثبت‌نام</a>
      <a class="dnav-item @(_isFinancial ? "active" : "")" href="/financial-hub"><i class="fa fa-credit-card"></i> مالی</a>
      <a class="dnav-item @(_isSpecialized ? "active" : "")" href="/specialized-hub"><i class="fa fa-building"></i> تخصصی</a>
    </aside>

    <!-- Main Content Area -->
    <main class="main-wrapper">
      @RenderBody()
    </main>

    <!-- Bottom Navigation Bar (Mobile) -->
    <nav class="bottom-nav">
      <a class="bnav-item @(_isDashboard ? "active" : "")" href="/dashboard"><i class="fa fa-home"></i> خانه</a>
      <a class="bnav-item @(_isProfile ? "active" : "")" href="/profile-hub"><i class="fa fa-user"></i> پروفایل</a>
      <a class="bnav-item @(_isRegistration ? "active" : "")" href="/registration"><i class="fa fa-edit"></i> ثبت‌نام</a>
      <a class="bnav-item @(_isFinancial ? "active" : "")" href="/financial-hub"><i class="fa fa-credit-card"></i> مالی</a>
      <a class="bnav-item @(_isSpecialized ? "active" : "")" href="/specialized-hub"><i class="fa fa-building"></i> تخصصی</a>
    </nav>
  </div>

  

  @if (TempData["Success"] != null)
  {
    <div id="toast-success" class="toast-success-banner">
      <i class="fa fa-check-circle"></i> @TempData["Success"]
    </div>
  }

  <!-- Modern Global AJAX Loading Spinner Overlay -->
  <div id="divLoader">
      <div class="loader-card">
          <i class="fa fa-circle-o-notch fa-spin"></i>
          <span>در حال ارسال و ثبت اطلاعات، لطفا صبور باشید...</span>
      </div>
  </div>

  <!-- Modern Global Result Notification Modal -->
  <div class="fs-modal-backdrop" id="alaram_box">
      <div class="fs-modal-card is-success" id="alarm_card">
          <button type="button" class="fs-modal-close" title="بستن">
              <i class="fa fa-times"></i>
          </button>
          <div class="fs-modal-icon-wrap" id="alarm_icon_wrap">
              <div class="fs-modal-icon-circle" id="alarm_icon_circle">
                  <i class="fa fa-check" id="alarm_icon"></i>
              </div>
          </div>
          <input type="hidden" id="hdn_alarm" value="" />
          <!-- Fallback elements for legacy script compatibility -->
          <span id="td1"></span>
          <span id="td2"></span>
          <img id="alarm_pic" />

          <h4 class="fs-modal-title" id="lbl1">ثبت اطلاعات</h4>
          <div class="fs-modal-body" id="td3">
              <p id="lbl2"></p>
          </div>
          <div class="fs-modal-footer">
              <button type="button" class="fs-modal-btn" id="alarm_btn">
                  <span>متوجه شدم</span>
                  <i class="fa fa-chevron-left modal-btn-chevron"></i>
              </button>
          </div>
      </div>
  </div>

  <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
  <script src="~/js/player.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
