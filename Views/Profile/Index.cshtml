@model FootballSchool.Web.Models.ApplicationUser
@{
    ViewData["Title"] = "پروفایل کاربری";
}

<div id="view-profile-hub" class="view-section fade-in">
    <div class="sticky-top-bar">
        <button class="btn-top-action btn-back-top" onclick="window.location.href='/Home/Index'"><i class="fa fa-arrow-right"></i> بازگشت</button>
        <h3 class="sticky-title">پروفایل کاربری</h3>
        <div style="width: 80px;"></div>
    </div>
    
    <div class="profile-hub-sections-wrapper">
        <div class="profile-header-card" style="display: flex; flex-direction: column; align-items: center; background: rgb(255, 255, 255); padding: 12px 24px; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); margin-bottom: 16px;">
            <div style="position: relative;">
                <img alt="Profile" src="~/assets/images/messi-profile.jpg" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary);">
                <button type="button" title="تغییر عکس پروفایل" style="position: absolute; bottom: 0px; right: 0px; background: var(--primary); color: rgb(255, 255, 255); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; border:none; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 5px;"><i class="fa fa-camera"></i></button>
            </div>
            <h3 style="margin-top: 16px; margin-bottom: 4px; color: var(--text-dark);">@(string.IsNullOrEmpty(Model.FirstName) && string.IsNullOrEmpty(Model.LastName) ? "کاربر بدون نام" : $"{Model.FirstName} {Model.LastName}")</h3>
            <p style="margin: 0px; color: var(--text-muted); font-size: 0.9rem;">کد ملی: @(string.IsNullOrEmpty(Model.NationalId) ? "ثبت نشده" : Model.NationalId)</p>
        </div>
        
        <div class="verify-banner unverified">
            <div class="verify-banner-content">
                <div class="verify-banner-icon" style="display: grid;align-items: center;justify-content: center;">
                    <i class="fa fa-shield" style="font-size: 2.4rem;"></i>
                </div>
                <div class="verify-banner-text">
                    <h4>کاربر استعلام هویتی نشده است!</h4>
                    <p>جهت استفاده از تمامی امکانات و ثبت‌نام، مدارک خود را تکمیل کنید.</p>
                </div>
            </div>
            <button class="btn-verify-action">تکمیل هویت</button>
        </div>
        
        <div class="profile-frame">
            <div class="frame-title"><i class="fa fa-user" style="color: var(--primary);"></i> اطلاعات فردی</div>
            <div class="frame-grid">
                <a href="/Profile/PersonalInfo" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-blue"><i class="fa fa-id-card-o"></i></div>
                    <span class="frame-item-label" style="color:var(--text-dark);">اطلاعات شخصی</span>
                </a>
                <a href="/Profile/ContactInfo" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-green"><i class="fa fa-phone"></i></div>
                    <span class="frame-item-label" style="color:var(--text-dark);">اطلاعات تماس</span>
                </a>
                <a href="/Profile/PassportInfo" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-orange"><i class="fa fa-globe"></i></div>
                    <span class="frame-item-label" style="color:var(--text-dark);">سایر (گذرنامه)</span>
                </a>
                <a href="/Profile/ClothingInfo" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-purple"><i class="fa fa-shirtsinbulk"></i></div>
                    <span class="frame-item-label" style="color:var(--text-dark);">سایز پوشاک</span>
                </a>
            </div>
        </div>
        
        <div class="profile-frame">
            <div class="frame-title"><i class="fa fa-credit-card" style="color: var(--warning);"></i> اطلاعات مالی</div>
            <div class="frame-grid">
                <a href="/Profile/BankInfo" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-orange"><i class="fa fa-bank"></i></div>
                    <span class="frame-item-label" style="color:var(--text-dark);">حساب‌های بانکی</span>
                </a>
            </div>
        </div>
        
        <div class="profile-frame">
            <div class="frame-title"><i class="fa fa-soccer-ball-o" style="color: var(--warning);"></i> اطلاعات ورزشی</div>
            <div class="frame-grid">
                <div class="frame-item">
                    <div class="frame-icon-circle ic-purple"><i class="fa fa-star"></i></div><span class="frame-item-label">مشخصات ورزشی</span>
                </div>
                <div class="frame-item">
                    <div class="frame-icon-circle ic-blue"><i class="fa fa-shield"></i></div><span class="frame-item-label">اطلاعات باشگاهی</span>
                </div>
            </div>
        </div>
        
        <div class="profile-frame">
            <div class="frame-title"><i class="fa fa-folder-open" style="color: var(--danger);"></i> مستندات و مدارک</div>
            <div class="frame-grid">
                <div class="frame-item">
                    <div class="frame-icon-circle ic-blue"><i class="fa fa-file-image-o"></i></div><span class="frame-item-label">کارت ملی</span>
                </div>
                <div class="frame-item">
                    <div class="frame-icon-circle ic-green"><i class="fa fa-file-text-o"></i></div><span class="frame-item-label">شناسنامه</span>
                </div>
                <div class="frame-item">
                    <div class="frame-icon-circle ic-purple"><i class="fa fa-certificate"></i></div><span class="frame-item-label">مجوز ورزشی</span>
                </div>
                <div class="frame-item">
                    <div class="frame-icon-circle ic-red-card"><i class="fa fa-plus-circle"></i></div><span class="frame-item-label">مدارک و سایر</span>
                </div>
            </div>
        </div>
        
        <div class="profile-frame">
            <div class="frame-title"><i class="fa fa-shield" style="color: var(--success);"></i> امنیت و حساب کاربری</div>
            <div class="frame-grid">
                <a href="/Identity/Account/Manage/ChangePassword" class="frame-item" style="text-decoration:none;">
                    <div class="frame-icon-circle ic-orange"><i class="fa fa-lock"></i></div><span class="frame-item-label" style="color:var(--text-dark);">تغییر رمز عبور</span>
                </a>
            </div>
        </div>
    </div>
</div>
