@{
    ViewData["Title"] = "Sports Info";
}

<div id="view-sports-info" class="view-section fade-in"><div class="sticky-top-bar"><button type="button" class="btn-top-action btn-back-top"><i class="fa fa-arrow-right"></i> بازگشت</button><h3 class="sticky-title">مشخصات ورزشی</h3><button type="submit" class="btn-top-action btn-submit-top"><i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات</button></div><div class="card"><form class="form-grid"><div class="input-group"><label class="">فصل مسابقاتی</label><div class="custom-select-wrapper  "><select name="competitionSeason" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="1402-1403">1402-1403</option><option value="1403-1404">1403-1404</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="input-group"><label class="">پست اصلی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="mainPosition" class="hidden-native-select" style="display: none;"><option value="مهاجم">مهاجم</option><option value="هافبک">هافبک</option><option value="مدافع">مدافع</option><option value="دروازه‌بان">دروازه‌بان</option></select><div class="custom-select-trigger ">انتخاب کنید</div></div></div><div class="input-group"><label class="">توانایی بازی در پست</label><input placeholder="مثال: هافبک دفاعی، دفاع وسط" class="" type="text" name="playingAbility"></div><div class="input-group"><label class="">پای تخصصی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="preferredFoot" class="hidden-native-select" style="display: none;"><option value="راست">راست</option><option value="چپ">چپ</option><option value="هردو">هردو</option></select><div class="custom-select-trigger ">انتخاب کنید</div></div></div><div class="input-group"><label>سابقه بازی در تیم ملی؟</label><div class="custom-select-wrapper  "><select name="hasNationalTeam" class="hidden-native-select" style="display: none;"><option value="false">خیر</option><option value="true">بله</option></select><div class="custom-select-trigger ">انتخاب کنید</div></div></div><div class="input-group"><label class="">شماره بیمه ورزشی <span class="text-danger">*</span></label><input maxlength="20" inputmode="numeric" class="" type="text" name="sportsInsuranceNumber"></div><div class="input-group"><label class="">سایز پیراهن ورزشی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="shirtSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S">S</option><option value="M">M</option><option value="L">L</option><option value="XL">XL</option><option value="XXL">XXL</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="input-group"><label class="">سایز شورت ورزشی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="shortsSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S">S</option><option value="M">M</option><option value="L">L</option><option value="XL">XL</option><option value="XXL">XXL</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="input-group"><label class="">سایز گرمکن ورزشی</label><div class="custom-select-wrapper  "><select name="sportsWarmerSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S">S</option><option value="M">M</option><option value="L">L</option><option value="XL">XL</option><option value="XXL">XXL</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="input-group"><label class="">سایز کفش فوتبال</label><input inputmode="numeric" placeholder="مثال: 42" class="" type="text" name="footballShoeSize" style="text-align: left; direction: ltr;"></div><div class="input-group"><label class="">سایز کفش راحتی</label><input inputmode="numeric" placeholder="مثال: 42" class="" type="text" name="slipperSize" style="text-align: left; direction: ltr;"></div><div class="input-group" style="grid-column: 1 / -1;"><label>شعار ورزشی</label><input type="text" name="sportsSlogan"></div><div class="input-group" style="grid-column: 1 / -1;"><label>توضیحات</label><textarea rows="3" name="description"></textarea></div><div class="desktop-anchor" style="display: none;"></div></form></div></div>