@model FootballSchool.Web.Models.ViewModels.PassportInfoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl"><head>
  

  

  <meta charset="utf-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>فوتبالیت - داشبورد مدرن</title>
  <link rel="stylesheet" href="/assets/fontawesome/css/font-awesome.min.css">
<link rel="stylesheet" href="/assets/index-dAlpofHF.css">
<style>
@@media (min-width: 768px) {
    #view-passport-info .form-grid {
        grid-template-columns: repeat(6, 1fr) !important;
    }
    /* Row 1: passport num, issue date, expiry date (span 2 each) */
    #view-passport-info .form-grid > .input-group:nth-child(1),
    #view-passport-info .form-grid > .input-group:nth-child(2),
    #view-passport-info .form-grid > .input-group:nth-child(3) {
        grid-column: span 2 !important;
    }
    /* Row 2: english name, english surname (span 3 each) */
    #view-passport-info .form-grid > .input-group:nth-child(4),
    #view-passport-info .form-grid > .input-group:nth-child(5) {
        grid-column: span 3 !important;
    }
    /* Description and photo stay full width */
    #view-passport-info .form-grid > .input-group:nth-child(6),
    #view-passport-info .form-grid > .input-group:nth-child(7),
    #view-passport-info .form-grid > .desktop-anchor {
        grid-column: 1 / -1 !important;
    }
}
</style>
</head>

<body>
  <div id="root"><nav class="top-navbar"><div class="navbar-container"><div class="header-profile"><div class="header-profile-avatar"><img alt="user" src="/assets/images/messi-profile.jpg"></div><div><div class="header-profile-info"><span class="name">نام نام خانوادگی</span><span class="meta"><i class="fa fa-calendar-check-o" style="margin-left: 4px;"></i>عضویت:<strong class="dir-ltr" style="margin-right: 4px;">- - - - / - - / - -</strong></span></div></div><i class="fa fa-angle-down" style="color: var(--text-muted); margin-right: 4px; font-size: 1.1rem;"></i><div id="profileMenu" class="profile-menu"><div style="display: flex; flex-direction: column; gap: 6px; padding: 16px 20px;"><div style="display: flex; flex-direction: row;"><div style="font-weight: 800; color: var(--text-dark); margin-bottom: 12px; font-size: 1.05rem; text-align: center; display: flex; justify-content: center; align-items: center;"> </div><div style="margin-right: auto; margin-bottom: 12px; display: flex; justify-content: center; cursor: pointer;" onclick="window.location.href='/verification'"><span class="badge-verify unverified" style="border-color: rgb(51, 65, 85);"><i class="fa fa-exclamation-circle"></i>استعلام هویت نشده</span></div></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>کد ملی:</span> <strong>- - - - - - - - - -</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>تاریخ تولد:</span> <strong class="dir-ltr">- - / - - / - - - -</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>سن:</span> <strong>۰ سال</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);"><span>رده سنی:</span> <strong>- - - - - - -</strong></div></div><a href="/verification" style="color: rgb(51, 65, 85);"><i class="fa fa-shield"></i>تایید هویت و مدارک</a><a href="/logout" style="color: var(--danger); padding: 12px 16px;"><i class="fa fa-sign-out"></i> خروج از حساب</a></div></div><div class="header-actions"><button class="btn-noti" title="اعلان‌ها" onclick="window.location.href='/bulletin'" style="cursor: pointer;"><i class="fa fa-bell-o"></i><span class="badge">۳</span></button><a href="#" class="btn-app-header" title="دانلود اپلیکیشن"><i class="fa fa-android"></i> <span>دانلود اپ</span></a></div></div></nav><aside class="desktop-sidebar"><div style="font-size: 0.75rem; font-weight: 800; color: var(--text-muted); margin-bottom: 16px; padding-right: 8px;">منوی اصلی</div><a class="dnav-item" href="/dashboard" data-discover="true"><i class="fa fa-home"></i> خانه</a><a class="dnav-item" href="/profile-hub" data-discover="true"><i class="fa fa-user"></i> پروفایل</a><a class="dnav-item" href="/registration" data-discover="true"><i class="fa fa-edit"></i> ثبت‌نام</a><a class="dnav-item" href="/financial-hub" data-discover="true"><i class="fa fa-credit-card"></i> مالی</a><a class="dnav-item" href="/specialized-hub" data-discover="true"><i class="fa fa-building"></i> تخصصی</a></aside><main class="main-wrapper"><div id="view-passport-info" class="view-section fade-in"><div class="sticky-top-bar"><button type="button" class="btn-top-action btn-back-top"/profile-hub'" onclick="window.location.href='/profile-hub'"><i class="fa fa-arrow-right"></i> بازگشت</button><h3 class="sticky-title">اطلاعات گذرنامه</h3><button type="submit" form="passport-info-form" class="btn-top-action btn-submit-top"><i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات</button></div><div class="card"><form class="form-grid" method="post" action="/passport-info" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="input-group" style="grid-column: 1 / -1;"><label class="">شماره گذرنامه <span class="text-danger">*</span></label><input maxlength="9" placeholder="شماره گذرنامه" class="" type="text" name="passportNumber" value="@Model?.PassportNumber" style="text-align: left; direction: ltr;"></div><div class="input-group"><label class="">تاریخ صدور <span class="text-danger">*</span></label><input type="text" class="" name="passportIssueDate" value="@Model?.PassportIssueDate" placeholder="1390/01/01"></div><div class="input-group"><label class="">تاریخ انقضا <span class="text-danger">*</span></label><input type="text" class="" name="passportExpiryDate" value="@Model?.PassportExpiryDate" placeholder="1410/01/01"></div><div class="input-group"><label class="">نام (انگلیسی) <span class="text-danger">*</span></label><input maxlength="50" class="" type="text" name="englishName" value="@Model?.EnglishName" style="text-align: left; direction: ltr;"></div><div class="input-group"><label class="">نام خانوادگی (انگلیسی) <span class="text-danger">*</span></label><input maxlength="50" class="" type="text" name="englishSurname" value="@Model?.EnglishSurname" style="text-align: left; direction: ltr;"></div><div class="input-group" style="grid-column: 1 / -1;"><label>توضیحات</label><textarea rows="3" maxlength="500" name="passportDescription">@Model?.PassportDescription</textarea></div><div class="input-group" style="grid-column: 1 / -1;"><label>تصویر گذرنامه</label><input name="passportPhoto" accept="image/*" type="file">@if (!string.IsNullOrEmpty(Model?.ExistingPassportPhotoPath)) {<div style="margin-top:8px;"><img src="@Model.ExistingPassportPhotoPath" style="max-width:200px;border-radius:8px;" alt="گذرنامه"></div>}</div><div class="desktop-anchor" style="display: none;"></div></form></div></div></main><nav class="bottom-nav"><a class="bnav-item" href="/dashboard" data-discover="true"><i class="fa fa-home"></i> خانه</a><a class="bnav-item" href="/profile-hub" data-discover="true"><i class="fa fa-user"></i> پروفایل</a><a class="bnav-item" href="/registration" data-discover="true"><i class="fa fa-edit"></i> ثبت‌نام</a><a class="bnav-item" href="/financial-hub" data-discover="true"><i class="fa fa-credit-card"></i> مالی</a><a class="bnav-item" href="/specialized-hub" data-discover="true"><i class="fa fa-building"></i> تخصصی</a></nav></div>
  


<script src="/assets/main.js"></script></body></html>







