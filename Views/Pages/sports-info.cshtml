@model FootballSchool.Web.Models.ApplicationUser
<!DOCTYPE html>
<html lang="fa" dir="rtl"><head>
  

  

  <meta charset="utf-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>فوتبالیت - داشبورد مدرن</title>
  <link rel="stylesheet" href="/assets/fontawesome/css/font-awesome.min.css">
<link rel="stylesheet" href="/assets/index-dAlpofHF.css"></head>

<body>
  <div id="root"><nav class="top-navbar"><div class="navbar-container"><div class="header-profile"><div class="header-profile-avatar"><img alt="user" src="/assets/images/messi-profile.jpg"></div><div><div class="header-profile-info"><span class="name">نام نام خانوادگی</span><span class="meta"><i class="fa fa-calendar-check-o" style="margin-left: 4px;"></i>عضویت:<strong class="dir-ltr" style="margin-right: 4px;">- - - - / - - / - -</strong></span></div></div><i class="fa fa-angle-down" style="color: var(--text-muted); margin-right: 4px; font-size: 1.1rem;"></i><div id="profileMenu" class="profile-menu"><div style="display: flex; flex-direction: column; gap: 6px; padding: 16px 20px;"><div style="display: flex; flex-direction: row;"><div style="font-weight: 800; color: var(--text-dark); margin-bottom: 12px; font-size: 1.05rem; text-align: center; display: flex; justify-content: center; align-items: center;"> </div><div style="margin-right: auto; margin-bottom: 12px; display: flex; justify-content: center; cursor: pointer;" onclick="window.location.href='/verification'"><span class="badge-verify unverified" style="border-color: rgb(51, 65, 85);"><i class="fa fa-exclamation-circle"></i>استعلام هویت نشده</span></div></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>کد ملی:</span> <strong>- - - - - - - - - -</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>تاریخ تولد:</span> <strong class="dir-ltr">- - / - - / - - - -</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;"><span>سن:</span> <strong>۰ سال</strong></div><div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);"><span>رده سنی:</span> <strong>- - - - - - -</strong></div></div><a href="/verification" style="color: rgb(51, 65, 85);"><i class="fa fa-shield"></i>تایید هویت و مدارک</a><a href="/logout" style="color: var(--danger); padding: 12px 16px;"><i class="fa fa-sign-out"></i> خروج از حساب</a></div></div><div class="header-actions"><button class="btn-noti" title="اعلان‌ها" onclick="window.location.href='/bulletin'" style="cursor: pointer;"><i class="fa fa-bell-o"></i><span class="badge">۳</span></button><a href="#" class="btn-app-header" title="دانلود اپلیکیشن"><i class="fa fa-android"></i> <span>دانلود اپ</span></a></div></div></nav><aside class="desktop-sidebar"><div style="font-size: 0.75rem; font-weight: 800; color: var(--text-muted); margin-bottom: 16px; padding-right: 8px;">منوی اصلی</div><a class="dnav-item" href="/dashboard" data-discover="true"><i class="fa fa-home"></i> خانه</a><a class="dnav-item" href="/profile-hub" data-discover="true"><i class="fa fa-user"></i> پروفایل</a><a class="dnav-item" href="/registration" data-discover="true"><i class="fa fa-edit"></i> ثبت‌نام</a><a class="dnav-item" href="/financial-hub" data-discover="true"><i class="fa fa-credit-card"></i> مالی</a><a class="dnav-item" href="/specialized-hub" data-discover="true"><i class="fa fa-building"></i> تخصصی</a></aside><main class="main-wrapper"><div id="view-sports-info" class="view-section fade-in"><div class="sticky-top-bar"><button type="button" class="btn-top-action btn-back-top"/profile-hub'" onclick="window.location.href='/profile-hub'"><i class="fa fa-arrow-right"></i> بازگشت</button><h3 class="sticky-title">مشخصات ورزشی</h3><button type="submit" form="sports-info-form" class="btn-top-action btn-submit-top"><i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات</button></div><div class="card"><form id="sports-info-form" class="form-grid" method="post" action="/sports-info">@Html.AntiForgeryToken()
<div asp-validation-summary="All" style="grid-column: 1 / -1; color: red; margin-bottom: 15px; font-weight: bold;"></div><div class="input-group"><label class="">فصل مسابقاتی</label><div class="custom-select-wrapper  "><select name="competitionSeason" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="1402-1403" selected="@(Model.CompetitionSeason == "1402-1403")">1402-1403</option><option value="1403-1404" selected="@(Model.CompetitionSeason == "1403-1404")">1403-1404</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.CompetitionSeason) ? "انتخاب کنید..." : Model.CompetitionSeason)</div></div></div><div class="input-group"><label class="">پست اصلی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="mainPosition" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید</option><option value="مهاجم" selected="@(Model.MainPosition == "مهاجم")">مهاجم</option><option value="هافبک" selected="@(Model.MainPosition == "هافبک")">هافبک</option><option value="مدافع" selected="@(Model.MainPosition == "مدافع")">مدافع</option><option value="دروازه‌بان" selected="@(Model.MainPosition == "دروازه‌بان")">دروازه‌بان</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.MainPosition) ? "انتخاب کنید" : Model.MainPosition)</div></div></div><div class="input-group"><label class="">توانایی بازی در پست</label><input placeholder="مثال: هافبک دفاعی، دفاع وسط" class="" type="text" name="playingAbility" value="@Model.PlayingAbility"></div><div class="input-group"><label class="">پای تخصصی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="preferredFoot" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید</option><option value="راست" selected="@(Model.PreferredFoot == "راست")">راست</option><option value="چپ" selected="@(Model.PreferredFoot == "چپ")">چپ</option><option value="هردو" selected="@(Model.PreferredFoot == "هردو")">هردو</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.PreferredFoot) ? "انتخاب کنید" : Model.PreferredFoot)</div></div></div><div class="input-group"><label>سابقه بازی در تیم ملی؟</label><div class="custom-select-wrapper  "><select name="hasNationalTeam" class="hidden-native-select" style="display: none;"><option value="false" selected="@(Model.HasNationalTeam == false)">خیر</option><option value="true" selected="@(Model.HasNationalTeam == true)">بله</option></select><div class="custom-select-trigger ">@(Model.HasNationalTeam == true ? "بله" : "خیر")</div></div></div><div class="input-group"><label class="">شماره بیمه ورزشی <span class="text-danger">*</span></label><input maxlength="20" inputmode="numeric" class="" type="text" name="sportsInsuranceNumber" value="@Model.SportsInsuranceNumber"></div><div class="input-group"><label class="">سایز پیراهن ورزشی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="shirtSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S" selected="@(Model.ShirtSize == "S")">S</option><option value="M" selected="@(Model.ShirtSize == "M")">M</option><option value="L" selected="@(Model.ShirtSize == "L")">L</option><option value="XL" selected="@(Model.ShirtSize == "XL")">XL</option><option value="XXL" selected="@(Model.ShirtSize == "XXL")">XXL</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.ShirtSize) ? "انتخاب کنید..." : Model.ShirtSize)</div></div></div><div class="input-group"><label class="">سایز شورت ورزشی <span class="text-danger">*</span></label><div class="custom-select-wrapper  "><select name="shortsSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S" selected="@(Model.ShortsSize == "S")">S</option><option value="M" selected="@(Model.ShortsSize == "M")">M</option><option value="L" selected="@(Model.ShortsSize == "L")">L</option><option value="XL" selected="@(Model.ShortsSize == "XL")">XL</option><option value="XXL" selected="@(Model.ShortsSize == "XXL")">XXL</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.ShortsSize) ? "انتخاب کنید..." : Model.ShortsSize)</div></div></div><div class="input-group"><label class="">سایز گرمکن ورزشی</label><div class="custom-select-wrapper  "><select name="sportsWarmerSize" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="S" selected="@(Model.SportsWarmerSize == "S")">S</option><option value="M" selected="@(Model.SportsWarmerSize == "M")">M</option><option value="L" selected="@(Model.SportsWarmerSize == "L")">L</option><option value="XL" selected="@(Model.SportsWarmerSize == "XL")">XL</option><option value="XXL" selected="@(Model.SportsWarmerSize == "XXL")">XXL</option></select><div class="custom-select-trigger ">@(string.IsNullOrEmpty(Model.SportsWarmerSize) ? "انتخاب کنید..." : Model.SportsWarmerSize)</div></div></div><div class="input-group"><label class="">سایز کفش فوتبال</label><input inputmode="numeric" placeholder="مثال: 42" class="" type="text" name="footballShoeSize" style="text-align: left; direction: ltr;" value="@Model.FootballShoeSize"></div><div class="input-group"><label class="">سایز کفش راحتی</label><input inputmode="numeric" placeholder="مثال: 42" class="" type="text" name="slipperSize" style="text-align: left; direction: ltr;" value="@Model.SlipperSize"></div><div class="input-group" style="grid-column: 1 / -1;"><label>شعار ورزشی</label><input type="text" name="sportsSlogan" value="@Model.SportsSlogan"></div><div class="input-group" style="grid-column: 1 / -1;"><label>توضیحات</label><textarea rows="3" name="sportsDescription">@Model.SportsDescription</textarea></div><div class="desktop-anchor" style="display: none;"></div></form></div></div></main><nav class="bottom-nav"><a class="bnav-item" href="/dashboard" data-discover="true"><i class="fa fa-home"></i> خانه</a><a class="bnav-item" href="/profile-hub" data-discover="true"><i class="fa fa-user"></i> پروفایل</a><a class="bnav-item" href="/registration" data-discover="true"><i class="fa fa-edit"></i> ثبت‌نام</a><a class="bnav-item" href="/financial-hub" data-discover="true"><i class="fa fa-credit-card"></i> مالی</a><a class="bnav-item" href="/specialized-hub" data-discover="true"><i class="fa fa-building"></i> تخصصی</a></nav></div>
  


<script src="/assets/main.js"></script></body></html>






