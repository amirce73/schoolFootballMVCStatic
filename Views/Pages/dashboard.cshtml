@model FootballSchool.Web.Models.ViewModels.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "داشبورد";
}

<div id="view-dashboard" class="view-section fade-in">
        <div class="modal-overlay">
          <div class="modal-box">
            <div class="modal-header-gradient">
              <button class="modal-close-btn">
                <i class="fa fa-times"></i>
              </button>
              <div class="modal-logo-wrap">
                <img alt="لوگو باشگاه" src="/assets/images/logo/Sepahan_New_Logo.svg" />
              </div>
              <h2>باشگاه فولاد مبارکه سپاهان</h2>
              <span class="modal-badge">کد ثبت: 10452</span>
            </div>
            <div class="modal-body-content">
              <h3>
                <i class="fa fa-info-circle modal-info-title-icon"></i>اطلاعات کامل مدرسه فوتبال
              </h3>
              <div class="modal-info-list">
                <div class="modal-info-item">
                  <div class="info-icon bg-blue">
                    <i class="fa fa-map-marker"></i>
                  </div>
                  <div>
                    <h4>آدرس دفتر مرکزی</h4>
                    <p>
                      سمنان، دامغان، خیابان شهید بهشتی، ورزشگاه انقلاب، دفتر
                      هیئت فوتبال
                    </p>
                  </div>
                </div>
                <div class="modal-info-item">
                  <div class="info-icon bg-green">
                    <i class="fa fa-phone"></i>
                  </div>
                  <div>
                    <h4>شماره‌های تماس</h4>
                    <p class="phone-numbers">
                      <span class="dir-ltr">023-35221234</span><span class="dir-ltr">09123456789</span>
                    </p>
                  </div>
                </div>
                <div class="modal-info-item">
                  <div class="info-icon bg-purple">
                    <i class="fa fa-user"></i>
                  </div>
                  <div>
                    <h4>مدیرعامل / موسس</h4>
                    <p>مهندس علی احمدی</p>
                  </div>
                </div>
              </div>
              <button class="btn-modal-close-large">بستن</button>
            </div>
          </div>
        </div>
        <div class="dashboard-grid">
          <div class="dashboard-top-row school-top-row">
            <div class="profile-card club-intro-card">
              <div class="profile-club-row club-intro-row">
                <div class="club-intro-group">
                  <div class="club-logo-wrapper">
                    <div class="club-logo club-logo-interactive">
                      <img alt="logo" src="/assets/images/logo/Sepahan_New_Logo.svg" />
                    </div>
                    <a href="tel:09123456789" class="club-phone-number-btn dir-ltr"><i class="fa fa-phone"></i>
                      09123456789</a>
                  </div>
                  <div class="club-info">
                    <h3 class="club-intro-title">
                      باشگاه فوتبال
                    </h3>
                    <div class="term-pill">ترم تابستان ۱۴۰۵</div>
                    <div class="club-intro-tag">
                      کلاس آموزشی
                    </div>
                    <button class="beautiful-modal-btn">
                      اطلاعات مدرسه فوتبال
                    </button>
                  </div>
                </div>
                <div class="social-column">
                  <a href="#" class="social-btn" title="تلگرام"><i class="fa fa-paper-plane social-icon-telegram"></i></a><a href="#" class="social-btn" title="اینستاگرام"><i class="fa fa-instagram social-icon-instagram"></i></a><a href="#" class="social-btn"
                    title="واتساپ"><i class="fa fa-whatsapp social-icon-whatsapp"></i></a><a href="#"
                    class="social-btn" title="وب‌سایت"><i class="fa fa-globe social-icon-globe"></i></a>
                </div>
              </div>
              <div class="profile-actions-box">
                <div class="action-row mb-6">
                  <span class="action-label"><i class="fa fa-exclamation-triangle action-warning-icon"></i>
                    اطلاعات شما تکمیل نیست (۳۲٪)</span><button class="btn-mini" onclick="event.stopPropagation(); window.location.href='/profile-hub'">تکمیل اطلاعات</button>
                </div>
                <div class="progress-bar-wrap">
                  <div class="progress-fill w-32"></div>
                </div>
              </div>
            </div>
            <div class="left-cards-container">
              <div class="card registration-card school-registration-card" onclick="window.location.href='/registration'">
                <div class="reg-label">
                  ثبت‌نام آنلاین
                </div>
                <div class="reg-val">
                  <i class="fa fa-user-plus"></i>
                </div>
                <div class="reg-status">
                  ورود
                </div>
              </div>
              <div class="card bmi-card school-top-bmi-card" onclick="window.location.href='/personal-info'">
                <div class="bmi-label">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                    >
                    <g transform="translate(0, -3)">
                      <path d="M4 18a8 8 0 0 1 16 0" stroke="#E2E8F0" stroke-width="4" stroke-linecap="round"></path>
                      <path d="M4 18 A 8 8 0 0 1 6.34 12.34" stroke="#3b82f6" stroke-width="4" stroke-linecap="round">
                      </path>
                      <path d="M6.34 12.34 A 8 8 0 0 1 12 10" stroke="#22c55e" stroke-width="4"></path>
                      <path d="M12 10 A 8 8 0 0 1 17.66 12.34" stroke="#eab308" stroke-width="4"></path>
                      <path d="M17.66 12.34 A 8 8 0 0 1 20 18" stroke="#ef4444" stroke-width="4" stroke-linecap="round">
                      </path>
                      <circle cx="12" cy="18" r="2.5" fill="#475569"></circle>
                      <path d="M12 18 L 10 11.5" stroke="#475569" stroke-width="2.5" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </g>
                  </svg>
                  <div class="bmi-label-col">
                    <span class="bmi-label-text-main">BMI</span><span class="bmi-label-text-sub">شاخص توده بدنی</span>
                  </div>
                </div>
                <div class="bmi-values-wrap">
                  <div class="bmi-val">
                    --
                  </div>
                  <div class="bmi-status">
                    نامشخص
                  </div>
                </div>
              </div>
              <div class="card debt-card status-clear school-debt-card" title="برای دیدن نمونه کلیک کنید">
                <div class="debt-info-wrap">
                  <div class="debt-info">
                    <span class="label">وضعیت مالی:</span><span class="amount">بدون بدهی</span>
                  </div>
                  <div class="debt-icon">
                    <i class="fa fa-check"></i>
                  </div>
                </div>
                <button class="btn-credit" title="افزایش اعتبار">
                  <i class="fa fa-plus"></i> شارژ
                </button>
              </div>
            </div>
          </div>
          <div class="stats-container-block">
            <div class="stats-grid school-stats-grid">
              <div class="stat-card school-stat-card">
                <div class="stat-icon ic-blue">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
                    <path d="M15 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke-linecap="round" stroke-linejoin="round">
                    </path>
                    <circle cx="8" cy="7" r="4" stroke-linecap="round" stroke-linejoin="round"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" opacity="0.5" stroke-linecap="round" stroke-linejoin="round">
                    </path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" opacity="0.5" stroke-linecap="round" stroke-linejoin="round">
                    </path>
                  </svg>
                </div>
                <div class="stat-info">
                  <span class="stat-label">رده سنی</span><span class="stat-val">بزرگسالان</span>
                </div>
              </div>
              <div class="stat-card school-stat-card" onclick="window.location.href='/attendance'">
                <div class="stat-icon ic-green">
                  <i class="fa fa-calendar-check-o"></i>
                </div>
                <div class="stat-info">
                  <span class="stat-label">کل | حضور در تمرین</span><span class="stat-val">۲۰ | ۱۴ (۷۰٪)</span>
                </div>
              </div>
              <div class="stat-card school-stat-card school-kpi-bmi" onclick="window.location.href='/personal-info'">
                <div class="stat-icon kpi-bmi-gauge">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="26" height="26">
                    <g transform="translate(0, -3)">
                      <path d="M4 18a8 8 0 0 1 16 0" stroke="#E2E8F0" stroke-width="4" stroke-linecap="round"></path>
                      <path d="M4 18 A 8 8 0 0 1 6.34 12.34" stroke="#3b82f6" stroke-width="4" stroke-linecap="round">
                      </path>
                      <path d="M6.34 12.34 A 8 8 0 0 1 12 10" stroke="#22c55e" stroke-width="4"></path>
                      <path d="M12 10 A 8 8 0 0 1 17.66 12.34" stroke="#eab308" stroke-width="4"></path>
                      <path d="M17.66 12.34 A 8 8 0 0 1 20 18" stroke="#ef4444" stroke-width="4" stroke-linecap="round">
                      </path>
                      <circle cx="12" cy="18" r="2.5" fill="currentColor"></circle>
                      <path d="M12 18 L 10 11.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </g>
                  </svg>
                </div>
                <div class="stat-info">
                  <span class="stat-label">شاخص BMI</span><span class="stat-val">نامشخص</span>
                </div>
              </div>
              <div class="stat-card school-stat-card" onclick="window.location.href='/talent'">
                <div class="stat-icon kpi-talent-search">
                  <i class="fa fa-search"></i>
                </div>
                <div class="stat-info">
                  <span class="stat-label">استعدادیابی</span><span class="stat-val">مشاهده</span>
                </div>
              </div>
              <div class="stat-card school-stat-card" onclick="window.location.href='/insurance-status'">
                <div class="stat-icon ic-orange">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round"
                      stroke-linejoin="round"></path>
                    <path d="M9 12h6M12 9v6" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"></path>
                  </svg>
                </div>
                <div class="stat-info">
                  <span class="stat-label">اعتبار بیمه</span><span class="stat-val">—</span>
                </div>
              </div>
            </div>
          </div>
          <div class="col-span-3 media-group-wrapper">
            <div class="dash-action-grid">
              <div class="dash-action-card card-store" onclick="window.location.href='/store'">
                <i class="fa fa-shopping-cart"></i>
                <h4>فروشگاه</h4>
              </div>
              <div class="dash-action-card card-gallery" onclick="window.location.href='/gallery'">
                <i class="fa fa-picture-o"></i>
                <h4>گالری</h4>
              </div>
              <div class="dash-action-card card-backpack" onclick="window.location.href='/training-backpack'">
                <i class="fa fa-briefcase"></i>
                <h4>ویدیو</h4>
              </div>
            </div>
            <div class="card news-card" onclick="window.location.href='/bulletin'">
              <div class="news-header">
                <h4>
                  <i class="fa fa-bell-o news-bell-icon"></i>
                  اطلاعیه و پیام‌ها
                </h4>
                <span class="badge-new">۱ پیام جدید</span>
              </div>
              <div class="news-body">
                برای مشاهده همه پیام‌های بولتن خبری کلیک کنید. ثبت‌نام در طرح
                ترم تابستان ۱۴۰۵ شروع شده است...<span class="news-date">۱۴۰۵/۰۳/۰۱</span>
              </div>
            </div>
          </div>
        </div>
      </div>
