@model FootballSchool.Web.Models.ViewModels.PersonalInfoViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "اطلاعات فردی";
    var user = ViewBag.User as FootballSchool.Web.Models.ApplicationUser;
}

<div id="view-personal-info" class="view-section fade-in">
                <div class="sticky-top-bar">
                    <button type="button" class="btn-top-action btn-back-top" onclick="window.location.href='/profile-hub'">
                        <i class="fa fa-arrow-right"></i> بازگشت
                    </button>
                    <h3 class="sticky-title">اطلاعات فردی</h3>
                    <button type="submit" form="personal-info-form" class="btn-top-action btn-submit-top">
                        <i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات
                    </button>
                </div>

                <!-- Modern AJAX Loading Spinner Overlay -->
                <div id="divLoader" style="display: none;">
                    <div class="loader-card">
                        <i class="fa fa-circle-o-notch fa-spin"></i>
                        <span>در حال ارسال و ثبت اطلاعات، لطفا صبور باشید...</span>
                    </div>
                </div>

                <!-- Modern Result Notification Modal -->
                <div class="fs-modal-backdrop" id="alaram_box" style="display: none; opacity: 0;" onclick="if(event.target === this) close_alarm_box();">
                    <div class="fs-modal-card is-success" id="alarm_card">
                        <button type="button" class="fs-modal-close" onclick="close_alarm_box();" title="بستن">
                            <i class="fa fa-times"></i>
                        </button>
                        <div class="fs-modal-icon-wrap" id="alarm_icon_wrap">
                            <div class="fs-modal-icon-circle" id="alarm_icon_circle">
                                <i class="fa fa-check" id="alarm_icon"></i>
                            </div>
                        </div>
                        <input type="hidden" id="hdn_alarm" value="" />
                        <!-- Fallback elements for legacy script compatibility -->
                        <span id="td1" style="display: none;"></span>
                        <span id="td2" style="display: none;"></span>
                        <img id="alarm_pic" style="display: none;" />

                        <h4 class="fs-modal-title" id="lbl1">ثبت اطلاعات</h4>
                        <div class="fs-modal-body" id="td3">
                            <p id="lbl2"></p>
                        </div>
                        <div class="fs-modal-footer">
                            <button type="button" class="fs-modal-btn" id="alarm_btn" onclick="close_alarm_box();">
                                <span>متوجه شدم</span>
                                <i class="fa fa-chevron-left" style="font-size: 0.8rem; margin-right: 4px;"></i>
                            </button>
                        </div>
                        <!-- 4-second auto-close progress bar -->
                        <div class="fs-modal-progress">
                            <div class="fs-modal-progress-bar" id="alarm_progress_bar"></div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <form id="personal-info-form" class="form-grid" method="post" action="/personal-info" onsubmit="event.preventDefault(); save_data(); return false;" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" style="grid-column: 1 / -1; color: red; margin-bottom: 15px; font-weight: bold; display: none;"></div>

                        <!-- 1. Profile Photo Selection Section -->
                        <div class="photo-upload-container">
                            <div class="photo-avatar-box" onclick="document.getElementById('FileUpload').click();" title="کلیک برای تغییر تصویر">
                                <img id="doc_pic" name="doc_pic" src="@(string.IsNullOrEmpty(user?.PassportPhotoPath) ? "/assets/images/messi-profile.jpg" : user.PassportPhotoPath)" alt="تصویر بازیکن" />
                                <div class="photo-avatar-overlay">
                                    <i class="fa fa-camera"></i>
                                </div>
                            </div>
                            <div class="photo-upload-details">
                                <span class="photo-title">تصویر پرسنلی بازیکن</span>
                                <span class="photo-hint">* فرمت‌های مجاز: JPG, PNG, WEBP, TIFF (حداکثر ۵ مگابایت)</span>
                                <div class="photo-actions-row">
                                    <button type="button" class="btn-select-photo" id="btn_FileUpload" onclick="document.getElementById('FileUpload').click();">
                                        <i class="fa fa-upload"></i> انتخاب تصویر پروفایل
                                    </button>
                                    <span class="photo-file-name" id="lbl_FileUpload"></span>
                                    <input type="file" id="FileUpload" name="profilePhoto" accept=".jpg,.jpeg,.png,.webp,.tiff" style="display: none;" onchange="previewImage(this);" />
                                </div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="">نام <span class="text-danger">*</span></label>
                            <input maxlength="50" class="" type="text" id="txt_name" name="firstName" value="@Model?.FirstName">
                        </div>

                        <div class="input-group">
                            <label class="">نام خانوادگی <span class="text-danger">*</span></label>
                            <input maxlength="50" class="" type="text" id="txt_family" name="lastName" value="@Model?.LastName">
                        </div>

                        <div class="input-group">
                            <label class="">کد ملی <span class="text-danger">*</span></label>
                            <input maxlength="10" inputmode="numeric" class="" type="text" id="txt_international_id" name="nationalId" value="@Model?.NationalId" onkeyup="if(typeof Set_value_numeric === 'function') Set_value_numeric(this.id, 10); if(typeof validateNationalIdRealtime === 'function') validateNationalIdRealtime();" oninput="if(typeof validateNationalIdRealtime === 'function') validateNationalIdRealtime();" onblur="if(typeof validateNationalIdRealtime === 'function') validateNationalIdRealtime();" onchange="if(typeof validateNationalIdRealtime === 'function') validateNationalIdRealtime();">
                        </div>

                        <div class="input-group">
                            <label class="">Name (لاتین)</label>
                            <input maxlength="50" class="dir-ltr" type="text" id="txt_eng_name" name="englishName" value="@Model?.EnglishName" placeholder="Name">
                        </div>

                        <div class="input-group">
                            <label class="">Family (لاتین)</label>
                            <input maxlength="50" class="dir-ltr" type="text" id="txt_eng_family" name="englishSurname" value="@Model?.EnglishSurname" placeholder="Family">
                        </div>

                        <div class="input-group">
                            <label class="">جنسیت <span class="text-danger">*</span></label>
                            <div class="custom-select-wrapper">
                                <select name="gender" id="cmd_gender" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="مرد" selected="@(Model?.Gender == "مرد")">مرد</option>
                                    <option value="زن" selected="@(Model?.Gender == "زن")">زن</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.Gender) ? "انتخاب کنید" : Model.Gender)</div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="">شماره شناسنامه</label>
                            <input maxlength="10" inputmode="numeric" class="" type="text" id="txt_id_no" name="birthCertificateNo" value="@Model?.BirthCertificateNo" onkeyup="if(typeof Set_value_numeric === 'function') Set_value_numeric(this.id, 10);">
                        </div>

                        <div class="input-group">
                            <label class="">شماره سریال شناسنامه</label>
                            <input maxlength="50" class="" type="text" id="txt_serial_id" name="serialId" value="@Model?.SerialId">
                        </div>

                        <div class="input-group">
                            <label class="">محل صدور</label>
                            <input maxlength="50" class="" type="text" id="txt_location_id" name="issuePlace" value="@Model?.IssuePlace">
                        </div>

                        <div class="input-group">
                            <label class="">نام پدر</label>
                            <input maxlength="50" class="" type="text" id="txt_father_name" name="fatherName" value="@Model?.FatherName">
                        </div>

                        <div class="input-group">
                            <label class="">شغل پدر</label>
                            <input maxlength="50" class="" type="text" id="txt_father_job" name="fatherJob" value="@Model?.FatherJob">
                        </div>

                        <!-- 2. Job changed to "شغل بازیکن" -->
                        <div class="input-group">
                            <label class="">شغل بازیکن</label>
                            <input maxlength="50" class="" type="text" id="txt_job" name="occupation" value="@Model?.Occupation">
                        </div>

                        <div class="input-group">
                            <label class="">تاریخ تولد <span class="text-danger">*</span></label>
                            <div id="birthDate" class="date-picker-input"
                                style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.85rem; background: #f8fafc; color: inherit; cursor: pointer; min-height: 42px; display: flex; align-items: center;">
                                <span style="color: @(Model?.BirthDate != null ? "inherit" : "#64748b");">@(Model?.BirthDate != null ? Model.BirthDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "انتخاب تاریخ")</span>
                            </div>
                            <input type="hidden" id="hidden_birthDate" name="birthDate" value="@(Model?.BirthDate != null ? Model.BirthDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "")" />
                            <input type="hidden" id="birth_date_shamsi" value="@(Model?.BirthDate != null ? Model.BirthDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "")" />
                        </div>

                        <div class="input-group">
                            <label class="">تاریخ تولد میلادی</label>
                            <input maxlength="10" class="dir-ltr" type="text" id="txt_birth_date_miladi" name="birthDateMiladi" value="@Model?.BirthDateMiladi" placeholder="YYYY/MM/DD">
                        </div>

                        <!-- 3. Age Field with Theme Primary Color (Yellow #eab308) Background -->
                        <div class="input-group">
                            <label class="">سن</label>
                            <input class="" type="text" id="lbl_age" name="age" value="@(string.IsNullOrEmpty(Model?.Age) ? "" : (Model.Age.EndsWith("سال") ? Model.Age : Model.Age + " سال"))" readonly style="background-color: rgba(234, 179, 8, 0.16) !important; color: #854d0e !important; border: 1.5px solid var(--primary, #eab308) !important; font-weight: 700 !important; cursor: default;">
                        </div>

                        <div class="input-group">
                            <label class="">ملیت <span class="text-danger">*</span></label>
                            <div class="custom-select-wrapper">
                                <select name="nationality" id="cmd_nationality_id" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="ایران" selected="@(Model?.Nationality == "ایران" || string.IsNullOrEmpty(Model?.Nationality))">ایران</option>
                                    <option value="اتباع خارجی" selected="@(Model?.Nationality == "اتباع خارجی")">اتباع خارجی</option>
                                    <option value="افغانستان" selected="@(Model?.Nationality == "افغانستان")">افغانستان</option>
                                    <option value="عراق" selected="@(Model?.Nationality == "عراق")">عراق</option>
                                    <option value="ترکیه" selected="@(Model?.Nationality == "ترکیه")">ترکیه</option>
                                    <option value="سایر" selected="@(Model?.Nationality == "سایر")">سایر</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.Nationality) ? "ایران" : Model.Nationality)</div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="">تابعیت</label>
                            <div class="custom-select-wrapper">
                                <select name="citizenship" id="cmd_citizenship" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="ایران" selected="@(Model?.Citizenship == "ایران" || string.IsNullOrEmpty(Model?.Citizenship))">ایران</option>
                                    <option value="افغانستان" selected="@(Model?.Citizenship == "افغانستان")">افغانستان</option>
                                    <option value="عراق" selected="@(Model?.Citizenship == "عراق")">عراق</option>
                                    <option value="سایر" selected="@(Model?.Citizenship == "سایر")">سایر</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.Citizenship) ? "ایران" : Model.Citizenship)</div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label>گروه خونی</label>
                            <div class="custom-select-wrapper">
                                <select name="bloodGroup" id="cmd_blood_type" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="A+" selected="@(Model?.BloodGroup == "A+")">A+</option>
                                    <option value="A-" selected="@(Model?.BloodGroup == "A-")">A-</option>
                                    <option value="B+" selected="@(Model?.BloodGroup == "B+")">B+</option>
                                    <option value="B-" selected="@(Model?.BloodGroup == "B-")">B-</option>
                                    <option value="AB+" selected="@(Model?.BloodGroup == "AB+")">AB+</option>
                                    <option value="AB-" selected="@(Model?.BloodGroup == "AB-")">AB-</option>
                                    <option value="O+" selected="@(Model?.BloodGroup == "O+")">O+</option>
                                    <option value="O-" selected="@(Model?.BloodGroup == "O-")">O-</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.BloodGroup) ? "انتخاب کنید..." : Model.BloodGroup)</div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="">قد (سانتی‌متر)</label>
                            <input maxlength="3" inputmode="numeric" class="" type="text" id="txt_Height" name="height" value="@Model?.Height" onkeyup="if(typeof Set_value_numeric === 'function') Set_value_numeric(this.id, 3);">
                        </div>

                        <div class="input-group">
                            <label class="">وزن (کیلوگرم)</label>
                            <input maxlength="3" inputmode="numeric" class="" type="text" id="txt_weight" name="weight" value="@Model?.Weight" onkeyup="if(typeof Set_value_numeric === 'function') Set_value_numeric(this.id, 3);">
                        </div>

                        <div class="input-group">
                            <label>وضعیت تاهل</label>
                            <div class="custom-select-wrapper">
                                <select name="maritalStatus" id="cmd_marital_status" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="مجرد" selected="@(Model?.MaritalStatus == "مجرد")">مجرد</option>
                                    <option value="متاهل" selected="@(Model?.MaritalStatus == "متاهل")">متاهل</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.MaritalStatus) ? "انتخاب کنید..." : Model.MaritalStatus)</div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label>وضعیت نظام وظیفه</label>
                            <div class="custom-select-wrapper">
                                <select name="militaryServiceStatus" id="cmd_military_service_status" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="مشمول" selected="@(Model?.MilitaryServiceStatus == "مشمول")">مشمول</option>
                                    <option value="معافیت تحصیلی" selected="@(Model?.MilitaryServiceStatus == "معافیت تحصیلی")">معافیت تحصیلی</option>
                                    <option value="معافیت دائم" selected="@(Model?.MilitaryServiceStatus == "معافیت دائم")">معافیت دائم</option>
                                    <option value="پایان خدمت" selected="@(Model?.MilitaryServiceStatus == "پایان خدمت")">پایان خدمت</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.MilitaryServiceStatus) ? "انتخاب کنید..." : Model.MilitaryServiceStatus)</div>
                            </div>
                        </div>

                        <!-- 4. Religion: Required constraint removed -->
                        <div class="input-group">
                            <label class="">دین</label>
                            <div class="custom-select-wrapper">
                                <select name="religion" id="cmd_religion" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="اسلام" selected="@(Model?.Religion == "اسلام")">اسلام</option>
                                    <option value="مسیحیت" selected="@(Model?.Religion == "مسیحیت")">مسیحیت</option>
                                    <option value="یهودیت" selected="@(Model?.Religion == "یهودیت")">یهودیت</option>
                                    <option value="زرتشتی" selected="@(Model?.Religion == "زرتشتی")">زرتشتی</option>
                                    <option value="سایر" selected="@(Model?.Religion == "سایر")">سایر</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.Religion) ? "انتخاب کنید..." : Model.Religion)</div>
                            </div>
                        </div>


                        <!-- 5. Health Status: Selectable ("سالم" / "غیر سالم") -->
                        <div class="input-group">
                            <label>وضعیت سلامت <span class="text-danger">*</span></label>
                            <div class="custom-select-wrapper">
                                <select name="healthStatus" id="cmd_health_status" class="hidden-native-select" style="display: none;">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="سالم" selected="@(Model?.HealthStatus == "سالم" || string.IsNullOrEmpty(Model?.HealthStatus))">سالم</option>
                                    <option value="غیر سالم" selected="@(Model?.HealthStatus == "غیر سالم")">غیر سالم</option>
                                </select>
                                <div class="custom-select-trigger">@(string.IsNullOrEmpty(Model?.HealthStatus) ? "سالم" : Model.HealthStatus)</div>
                            </div>
                        </div>

                        <div class="input-group" style="grid-column: 1 / -1;">
                            <label>توضیحات</label>
                            <textarea rows="3" maxlength="500" id="txt_description" name="description">@Model?.Description</textarea>
                        </div>

                        <div class="mobile-only-spacer" style="height: 85px; flex-shrink: 0;"></div>
                        <div class="desktop-anchor" style="display: none;"></div>
                    </form>
                </div>

                <!-- Mobile Sticky Submit Button (Fixed at bottom on mobile) -->
                <div class="sticky-submit-wrapper">
                    <button type="button" class="sticky-submit-btn" id="btn_sticky_submit" onclick="event.preventDefault(); save_data(); return false;">
                        <i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات
                    </button>
                </div>
            </div>

@section Styles {
<style>
.fs-modal-progress {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 4px;
    background: rgba(0,0,0,0.06);
    border-radius: 0 0 26px 26px;
    overflow: hidden;
}
.fs-modal-progress-bar {
    height: 100%;
    width: 100%;
    transform-origin: left;
    animation: fsModalTimer 4s linear forwards;
}
.fs-modal-card.is-success .fs-modal-progress-bar { background: linear-gradient(to right, #10b981, #059669); }
.fs-modal-card.is-error   .fs-modal-progress-bar { background: linear-gradient(to right, #ef4444, #dc2626); }
.fs-modal-card.is-warning .fs-modal-progress-bar { background: linear-gradient(to right, #f59e0b, #d97706); }
@@keyframes fsModalTimer {
    0%   { transform: scaleX(1); }
    100% { transform: scaleX(0); }
}
</style>
}

@section Scripts {
    <script src="~/js/personal-info.js" asp-append-version="true"></script>
}
