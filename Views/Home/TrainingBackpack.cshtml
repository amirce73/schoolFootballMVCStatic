@{
    ViewData["Title"] = "Training Backpack";
}

<div id="view-training-backpack" class="view-section fade-in"><div class="sticky-top-bar"><button class="btn-top-action btn-back-top"><i class="fa fa-arrow-right"></i> بازگشت</button><h3 class="sticky-title">کوله تمرینات</h3><div style="width: 80px;"></div><button type="submit" class="btn-top-action btn-submit-top"><i class="fa fa-check" style="margin-left: 8px;"></i>ثبت اطلاعات</button></div><div class="backpack-container"><div class="backpack-header"><div class="backpack-icon"><i class="fa fa-briefcase"></i></div><div class="backpack-title-box"><h2>کوله پشتی تمرین شما</h2><p>برنامه‌ها و آیتم‌های تمرینی خود را در اینجا پیکربندی کنید</p></div></div><div class="backpack-form-card"><form class="backpack-form"><div class="form-group"><label>رشته ورزشی</label><div class="custom-select-wrapper  form-control"><select name="backpackSport" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="football">فوتبال</option><option value="futsal">فوتسال</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="form-group"><label>موضوع تمرین</label><div class="custom-select-wrapper  form-control"><select name="backpackTopic" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="tactical">تاکتیکی</option><option value="technical">تکنیکی</option><option value="physical">بدنسازی و آمادگی جسمانی</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="form-group"><label>رده سنی</label><div class="custom-select-wrapper  form-control"><select name="backpackAgeGroup" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="u10">زیر ۱۰ سال</option><option value="u14">نونهالان (زیر ۱۴ سال)</option><option value="u16">نوجوانان (زیر ۱۶ سال)</option><option value="u18">جوانان (زیر ۱۸ سال)</option><option value="adults">بزرگسالان</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><div class="form-group"><label>نوع تمرین</label><div class="custom-select-wrapper  form-control"><select name="backpackTrainingType" class="hidden-native-select" style="display: none;"><option value="">انتخاب کنید...</option><option value="group">گروهی</option><option value="individual">انفرادی</option><option value="match">بازی تدارکاتی</option></select><div class="custom-select-trigger ">انتخاب کنید...</div></div></div><button type="button" class="btn-backpack-submit">ذخیره تنظیمات و مشاهده برنامه‌ها</button><div class="desktop-anchor" style="display: none;"></div></form></div></div></div>