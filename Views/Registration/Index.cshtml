@model FootballSchool.Web.Models.ViewModels.RegistrationViewModel

@{
    ViewData["Title"] = "ثبت‌نام در دوره";
}

<div id="view-registration" class="view-section fade-in">
    <div class="sticky-top-bar">
        <a asp-controller="Home" asp-action="Index" class="btn-top-action btn-back-top"><i class="fa fa-arrow-right"></i> بازگشت</a>
        <h3 class="sticky-title">ثبت‌نام در دوره</h3>
        <button type="submit" form="registrationForm" class="btn-top-action btn-submit-top">
            <i class="fa fa-check" style="margin-left: 8px;"></i>ثبت نام
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3 mx-3">
            @TempData["SuccessMessage"]
        </div>
    }

    <form id="registrationForm" asp-controller="Registration" asp-action="Index" method="post">
        <div class="registration-grid">
            <div class="card" style="overflow: visible;">
                <div class="form-grid">
                    <div class="input-group desktop-full-width">
                        <label asp-for="TermId"></label>
                        <select asp-for="TermId" asp-items="Model.Terms" class="form-control">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="TermId" class="text-danger"></span>
                    </div>

                    <div class="input-group desktop-full-width">
                        <label asp-for="AgeCategoryId"></label>
                        <select asp-for="AgeCategoryId" asp-items="Model.AgeCategories" class="form-control">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="AgeCategoryId" class="text-danger"></span>
                    </div>

                    <div class="checkbox-group" style="grid-column: 1 / -1; background: var(--primary-light); padding: 12px; border-radius: var(--radius-base); border: 1px solid rgba(234, 179, 8, 0.3); color: var(--text-dark);">
                        <label style="color: var(--text-dark); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input asp-for="RulesAccepted" style="width: auto; transform: scale(1.2);" />
                            @Html.DisplayNameFor(m => m.RulesAccepted)
                        </label>
                        <span asp-validation-for="RulesAccepted" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card" style="padding: 16px; margin-top: 0px;">
                <h4 style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px; color: var(--text-dark); font-weight: 800;">
                    <i class="fa fa-pie-chart" style="color: var(--primary);"></i> گزارش مالی ثبت‌نام‌ها
                </h4>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem;">
                    <span>کل پرداختی‌های شما:</span>
                    <strong style="color: var(--success);">@Model.TotalPaid.ToString("N0") تومان</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 0.85rem;">
                    <span>بدهی فعلی (ترم جاری):</span>
                    <strong style="color: var(--danger);">@Model.CurrentDebt.ToString("N0") تومان</strong>
                </div>
                <a asp-controller="Financial" asp-action="Index" style="width: 100%; display: block; text-align: center; background: rgb(248, 250, 252); color: var(--text-dark); border: 1px solid var(--border); padding: 12px; border-radius: var(--radius-sm); font-weight: 800; text-decoration: none; transition: 0.2s;">
                    <i class="fa fa-history" style="color: var(--primary);"></i> مشاهده تایم‌لاین مالی تراکنش‌ها
                </a>
            </div>
        </div>
    </form>
    <div class="desktop-anchor" style="display: none;"></div>
</div>

