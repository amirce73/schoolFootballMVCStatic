@{
    ViewData["Title"] = "Certificate";
}

<div id="view-certificate" class="view-section fade-in"><div class="sticky-top-bar"><button class="btn-top-action btn-back-top"><i class="fa fa-arrow-right"></i> بازگشت</button><h3 class="sticky-title">سایر مدارک</h3><button class="btn-top-action btn-submit-top"><i class="fa fa-plus"></i> مدرک جدید</button></div><div class="card" style="padding: 15px;"><div style="display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap;"><div class="input-group" style="flex: 1 1 0%; min-width: 150px;"><div class="custom-select-wrapper  "><select class="hidden-native-select" style="display: none;"><option value="">همه فصل‌ها</option><option value="1402-1403">1402-1403</option><option value="1403-1404">1403-1404</option></select><div class="custom-select-trigger ">همه فصل‌ها</div></div></div><div class="input-group" style="flex: 1 1 0%; min-width: 150px;"><div class="custom-select-wrapper  "><select class="hidden-native-select" style="display: none;"><option value="">همه مدارک</option><option value="medical">پزشکی</option><option value="educational">تحصیلی</option><option value="other">متفرقه</option></select><div class="custom-select-trigger ">همه مدارک</div></div></div></div><div class="table-responsive"><table class="data-table"><thead><tr><th>عنوان</th><th>تصویر</th><th>تاریخ صدور</th><th>تاریخ انقضا</th><th>صادرکننده</th><th>توضیحات</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody><tr><td data-label="عنوان">گواهی سلامت پزشکی</td><td data-label="تصویر"><div style="width: 40px; height: 40px; background: rgb(238, 238, 238); border-radius: 4px; display: flex; align-items: center; justify-content: center;"><i class="fa fa-image" style="color: rgb(204, 204, 204);"></i></div></td><td data-label="تاریخ صدور" style="direction: ltr; text-align: right;">1402/05/10</td><td data-label="تاریخ انقضا" style="direction: ltr; text-align: right;">1403/05/10</td><td data-label="صادرکننده">مرکز پزشکی ورزشی</td><td data-label="توضیحات"><span title="سلامت کامل برای حضور در مسابقات">سلامت کامل برای...</span></td><td data-label="وضعیت"><span style="padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; background-color: rgba(76, 175, 80, 0.1); color: var(--success-color);">تایید شده</span></td><td data-label="عملیات"><div style="display: flex; justify-content: flex-end; gap: 5px;"><button class="btn-icon" title="دانلود"><i class="fa fa-download" style="color: var(--primary-color);"></i></button><button class="btn-icon" title="حذف"><i class="fa fa-trash" style="color: var(--danger-color);"></i></button></div></td></tr></tbody></table></div></div></div>