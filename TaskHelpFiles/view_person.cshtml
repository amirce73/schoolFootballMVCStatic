    $(function () {
        $(".select2").select2();
    });
    function set_age_param()
    {
        set_age('birth_date_shamsi', 'lbl_age');
        var temp= parseInt(document.getElementById('lbl_age').innerHTML);
        if(temp<18)
        {
            if(document.getElementById("cmd_military_service_status").value=='0' || document.getElementById("cmd_military_service_status").value=='')
                document.getElementById("cmd_military_service_status").value = 5;
            if (document.getElementById("cmd_marital_status").value == '0' || document.getElementById("cmd_marital_status").value == '')
                document.getElementById("cmd_marital_status").value = 1;
       }
    }
    function save_data()
    {
        document.getElementById('soccer_id').value = document.getElementById('cmb_soccer').value;


           var formData = new FormData();
        var totalFiles = document.getElementById("FileUpload").files.length;
        for (var i = 0; i < totalFiles; i++) {
            var file = document.getElementById("FileUpload").files[i];
            formData.append("FileUpload", file);
        }


        formData.append("name", $("#txt_name").val());
        formData.append("family", $("#txt_family").val());
        formData.append("eng_name", $("#txt_eng_name").val());
        formData.append("eng_family", $("#txt_eng_family").val());
        formData.append("international_id", $("#txt_international_id").val());
        formData.append("person_id", $("#person_id").val());
        formData.append("id_no", $("#txt_id_no").val());
        formData.append("serial_id", $("#txt_serial_id").val());
        formData.append("location_id", $("#txt_location_id").val());
        formData.append("father_name", $("#txt_father_name").val());
        formData.append("father_job", $("#txt_father_job").val());
        formData.append("birth_date_shamsi", $("#birth_date_shamsi").val());
        formData.append("birth_date_miladi", $("#txt_birth_date_miladi").val());
        formData.append("nationality_id_FK2", $("#cmd_nationality_id").val());
        formData.append("citizenship2", $("#cmd_citizenship").val());
        formData.append("health_status2", $("#cmd_health_status").val());
        formData.append("blood_type2", $("#cmd_blood_type").val());
        formData.append("Height", $("#txt_Height").val());
        formData.append("weight", $("#txt_weight").val());
        formData.append("gender2", $("#cmd_gender").val());
        formData.append("marital_status2", $("#cmd_marital_status").val());
        formData.append("military_service_status2", $("#cmd_military_service_status").val());
        formData.append("job", $("#txt_job").val());
        formData.append("religion2", $("#cmd_religion").val());
        formData.append("user_id_FK", $("#soccer_id").val());
        formData.append("description", $("#txt_description").val());
        //alert('ss');
        $.ajax({
            url: "/FootballschoolPerson/view_person",
            type: "POST",
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response,data) {
                //alert(response.errorcode);
                if (response.errorcode != "0") {
                    document.getElementById("td1").style.backgroundColor = "red";
                    document.getElementById("td2").style.backgroundColor = "red";
                    document.getElementById("alarm_btn").className = "btn-Pcustome-alarm";
                    document.getElementById("alaram_box").className = "alarm_box";
                    //document.getElementById('alarm_pic').src = '/Content/images/Cancel-128.png';
                    document.getElementById("lbl1").innerText = "خطا در ثبت اطلاعات";
                }
                switch (response.errorcode)
                {
                    case "1": document.getElementById("lbl2").innerText = "شما مدت زیادی است که از سیستم استفاده نکرده‌اید. لطفا مجددا وارد شوید."; break;
                    case "2": document.getElementById("lbl2").innerText = "کد ملی وارد شده تکراری است!"; break;
                    case "3": document.getElementById("lbl2").innerText = "لازم است شما مجددا در سیستم وارد شوید."; break;
                    case "6": document.getElementById("lbl2").innerText = "خطا در بارگذاری تصویر بازیکن."; break;
                    case "10": document.getElementById("lbl2").innerText = "در ثبت اطلاعات با خطائی مواجه شده‌اید. لطفا مجددا سعی نمائید."; break;
                    case "0": document.getElementById("td1").style.backgroundColor = "green";
                        document.getElementById("td2").style.backgroundColor = "green";
                        document.getElementById("alarm_btn").className = "btn-success"
                        document.getElementById("alaram_box").className = "inform_box"
                        //document.getElementById('alarm_pic').src = '/Content/images/ok1.jpg';
                        document.getElementById("lbl1").innerText = "ثبت اطلاعات";
                        document.getElementById("lbl2").innerText = "اطلاعات با موفقیت ذخیره شد"; break;

                }

                //alert(response.errorcode);
                $('#alaram_box').hide().fadeIn(1000);
            },
            error: function (response,jqXHR, errorThrown) {

                document.getElementById("td1").style.backgroundColor = "red";
                document.getElementById("td2").style.backgroundColor = "red";
                document.getElementById("alarm_btn").className = "btn-Pcustome-alarm";
                document.getElementById("alaram_box").className = "alarm_box";
                //document.getElementById('alarm_pic').src = '/Content/images/Cancel-128.png';
                document.getElementById("lbl1").innerText = "خطا در ثبت اطلاعات";
                document.getElementById("lbl2").innerText = "در ثبت اطلاعات با خطائی مواجه شده‌اید. لطفا مجددا سعی نمائید.";
                $('#alaram_box').hide().fadeIn(1000);

            },
            // callback handler that will be called on completion
            // which means, either on success or error
            complete: function () {
            }
        });
    }
    function set_data(flag) {

        document.getElementById('divLoader').style.display = 'block';
        document.getElementById('flag').value = flag;
        document.getElementById('soccer_id').value = document.getElementById('cmb_soccer').value;

        var soccer_id = $("#cmb_soccer").val();
        var obj = { soccer_id: soccer_id, flag: flag };

        $.ajax({
            url: "/FootballschoolPerson/view_person2",
            type: "get",
            data: obj,
            success: function (response, data) {
                //
                document.getElementById('soccer_id').value = response.model.user_id_FK;
                document.getElementById('person_id').value = response.model.person_id;
                document.getElementById('txt_name').value = response.model.name;
                document.getElementById('txt_family').value = response.model.family;
                document.getElementById('txt_eng_name').value = response.model.eng_name;
                document.getElementById('txt_eng_family').value = response.model.eng_family;
                document.getElementById('txt_international_id').value = response.model.international_id;
                document.getElementById('txt_id_no').value = response.model.id_no;
                document.getElementById('txt_serial_id').value = response.model.serial_id;
                document.getElementById('txt_location_id').value = response.model.location_id;
                document.getElementById('txt_father_name').value = response.model.father_name;
                document.getElementById('txt_father_job').value = response.model.father_job;
                document.getElementById('birth_date_shamsi').value = response.model.birth_date_shamsi;
                document.getElementById('txt_birth_date_miladi').value = response.model.birth_date_miladi;
                document.getElementById('cmd_nationality_id').value = response.model.nationality_id_FK2;
                document.getElementById('cmd_citizenship').value = response.model.citizenship2;
                document.getElementById('cmd_health_status').value = response.model.health_status2;
                document.getElementById('cmd_blood_type').value = response.model.blood_type2;
                document.getElementById('txt_Height').value = response.model.Height;
                document.getElementById('txt_weight').value = response.model.weight;
                document.getElementById('cmd_gender').value = response.model.gender2;
                document.getElementById('cmd_marital_status').value = response.model.marital_status2;
                document.getElementById('cmd_military_service_status').value = response.model.military_service_status2;
                document.getElementById('txt_job').value = response.model.job;
                document.getElementById('cmd_religion').value = response.model.religion2;
                document.getElementById('txt_description').value = response.model.description;
                document.getElementById('doc_pic').src = response.model.pictuer;
                set_age_param();
                document.getElementById('divLoader').style.display = 'none';

           },
            error: function (jqXHR, errorThrown) {
                document.getElementById('divLoader').style.display = 'none';

                alert('error');

            }
        });


    }
    function check_data()
    {

        jalali_to_gregorian('birth_date_shamsi', 'txt_birth_date_miladi');
        set_age_param();
        if (document.getElementById("txt_name" ).value == '') {
            display_alarm2("نام بازیکن وارد نشده است. ثبت اطلاعات برای فیلدهای ستاره‌دار الزامی است", "لطفا فیلدهای ستاره‌دار را وارد کنید", "", 0);
            return false;
        }
        if (document.getElementById("txt_family").value == '') {
            display_alarm2("نام خانوادگی بازیکن وارد نشده است. ثبت اطلاعات برای فیلدهای ستاره‌دار الزامی است", "لطفا فیلدهای ستاره‌دار را وارد کنید", "", 0);
            return false;
        }
         if (document.getElementById("txt_international_id" ).value == '') {
            display_alarm2("کد ملی بازیکن وارد نشده است. ثبت اطلاعات برای فیلدهای ستاره‌دار الزامی است", "لطفا فیلدهای ستاره‌دار را وارد کنید", "", 0);
            return false;
        }


         if (document.getElementById('cmd_nationality_id' ).value != '24') {
            if (!CheckMeliCode('txt_international_id')) {
                display_alarm('کد ملی وارد شده معتبر نمی‌باشد.', ''); return false;
            }
        }
         if (document.getElementById('cmd_nationality_id' ).value == '24') {

            if (!CheckfaragirCode('txt_international_id')) {
                display_alarm('کد فراگیر را عددی وارد کنید کد وارد شده معتبر نمی‌باشد.', ''); return false;
            }
        }
         if (!checkdate('birth_date_shamsi')
                || document.getElementById("birth_date_shamsi").value.length < 10
                || document.getElementById("birth_date_shamsi").value.length > 10
                || document.getElementById("birth_date_shamsi" ).value.substr(4, 1) != '/'
                || document.getElementById("birth_date_shamsi").value.substr(7, 1) != '/') {
            display_alarm2("تاریخ وارد شده صحیح نیست . لطفا تاریخ تولد شمسی را با فرمت YYYY/MM/DD وارد کنید.", "خطا در ثبت تاریخ تولد شمسی", "", 0);
            return false;

         }
        if (!checkdate_miladi('txt_birth_date_miladi' )
                || document.getElementById("txt_birth_date_miladi").value.length < 10
                || document.getElementById("txt_birth_date_miladi").value.length > 10
                || document.getElementById("txt_birth_date_miladi").value.substr(4, 1) != '/'
                || document.getElementById("txt_birth_date_miladi").value.substr(7, 1) != '/') {
            display_alarm2("تاریخ وارد شده صحیح نیست . لطفا تاریخ تولد میلادی را با فرمت YYYY/MM/DD وارد کنید.", "خطا در ثبت تاریخ تولد میلادی", "", 0);
            return false;
        }
        if (!CheckMeliCode('txt_international_id'))
        {
            display_alarm2("کد ملی وارد شده صحیح نیست . لطفا کد ملی را صحیح وارد کنید.", "خطا در ثبت کد ملی", "", 0);
            return false;
 }

        return true;
    }
</script>
