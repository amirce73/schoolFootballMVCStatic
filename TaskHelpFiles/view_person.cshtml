@model footbalit_project.Models.person
@{
    ViewBag.Title = "view_person";
    Layout = "~/Views/Share/_MainlayoutFS.cshtml";
}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preload"
      as="style"
      onload="this.rel = 'stylesheet'"
      href="~/Content/assets/css/style -footballit-new.css">
<noscript>
    <link rel="stylesheet"
          href="~/Content/assets/css/style -footballit-new.css">
</noscript>
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
@using (Html.BeginForm("view_person", "FootballschoolPerson", FormMethod.Post, new { enctype = "multipart/form-data", id = "view_person", @style = "display:none;" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="divLoader" style="background-color:red;display:none;top: 30%;left: 50%;z-index:1000000;position:absolute;">
        <div id="spin-wrap">
            <div id="spin"></div>
        </div>
    </div>
    <div class=@ViewBag.alarmclass style="top: 30%;left: 40%;width: 400px;height: 180px;z-index:1000" id="alaram_box">
        <table style="width:100%; direction:rtl">
            <tr>
                <td style="background-color:@ViewBag.td_class;color:#fff;width:90%" id="td1">
                    <label id="lbl1">@ViewBag.alarmText_title</label>
                    <input type="hidden" id="hdn_alarm" value="" />
                </td>
                <td style="background-color:@ViewBag.td_class;color:#fff;width:10%" id="td2">
                    <img src=@ViewBag.alarmpic id="alarm_pic" />
                </td>
            </tr>
            <tr>
                <td style="height:80px;" align="center" valign="middle" id="td3" colspan="2">
                    <label id="lbl2">@ViewBag.alarmText</label>
                </td>
            </tr>
            <tr>
                <td align="center" valign="middle" colspan="2">
                    <input type="button" value="تائید" class=@ViewBag.btn_class id="alarm_btn" style="width:80px;" onclick="close_alarm_box();" />
                </td>
            </tr>
        </table>
    </div>
    <div align="center">
        <div class="header-containe">
            <ul class="breadcrumb-new">
                <li><a href="#"><span class="icon icon-home"> </span></a></li>
                <li><a href="#"><i class="fa fa-circle-o"></i> اطلاعات فردی و ورزشی بازیکنان</a></li>
                <li><a href="#"><i class="fa fa-circle-o"></i> مشخصات فردی بازیکنان</a></li>

            </ul>
        </div>
        <div class="container-form">
            <form class="form-horizontal">
                <fieldset>
                    <div class="row form-filter player-filter" style="max-height:initial;height:auto">
                        <div class=" col-md-12 col-sm-12 col-xs-12" style="background: #ebeeee;font-size:12px;display: inherit;">
                            <div class="col-sm-3" style="background: #ebeeee">
                                <label class="control-label d-inline" style="font-size:12px;line-height:3.5;" for=""> انتخاب بازیکن :</label>
                            </div>
                            <div class="col-sm-9" style="background: #ebeeee; margin-bottom: 0.75rem;">
                                @Html.DropDownListFor(model => model.user_id_FK, ViewBag.soccer as List<SelectListItem>, null, new { @class = "form-control dropdown-toggle_custome select2", id = "cmb_soccer", @style = "width: 100%;", onchange = "set_data(1);" })

                            </div>
                            @Html.HiddenFor(model => model.person_id, new { htmlAttributes = new { @class = "form-control", id = "hdn_person_id" } })
                            @Html.HiddenFor(model => model.user_id_FK, new { htmlAttributes = new { @class = "form-control", id = "user_id_FK" } })
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
        <input type="hidden" id="soccer_id" name="soccer_id" />
        <input type="hidden" id="flag" name="flag" />
