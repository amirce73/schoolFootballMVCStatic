                        <span class="drop-zone__prompt">
                            <img style="width:10rem;" id="doc_pic" name="doc_pic" src="~/Content/assets/images/up-gif.png" />
                        </span>
                        <input id="FileUpload" type="file" name="myFile" class="drop-zone__input">
                    </div>
                </div>
                @*~/Content/assets/images/up-gif.gif*@
                <div class="img-upload-detail col-lg-10 col-md-9 col-sm-6 col-xs-12 float-right">
                    <div class="row up-load-detail ">
                        <div class=" col-md-6 col-sm-12 col-xs-12 float-right">
                            <p style="color: #808080;font-size: 12px;text-align: right;clear: both; font-weight:700">   لطفا عکس مورد نظر خود را بارگزاری کنید</p>
                            <p style="color: #ff0000;font-size: 11px;text-align: right;clear: both;">   *لطفا فقط فایلهای با پسوند jpg , jpeg , png و یا tiff  بارگزاری شود.</p>
                        </div>
                        <div class=" col-md-6 col-sm-12 col-xs-12 float-right">
                            <button style="margin:.5rem auto !important;float: left;" class="btn btn-accept" ID="btn_FileUpload" onclick="document.getElementById('FileUpload').click(); return(false);">انتخاب فایل</button>
                            <label id="lbl_FileUpload"></label>
                            @Html.TextBox("file", "", new { type = "file", accept = "jpg/jpeg/tiff", style = "width:80%;display:none;", id = "FileUpload", onchange = "document.getElementById('lbl_FileUpload').innerHTML =document.getElementById('FileUpload').files[0].name;" })
                        </div>
                    </div>
                    <input id="FileData" name="FileData" type="hidden" />
                </div>
            </div>
            <div class="row">
                <br>
                <div class="col-md-4 col-sm-4 col-xs-12 float-right row-flex mb-1-5">
                    <lable class="lable-form">
                        نام:
                        <span style="color:red;direction:ltr;width:4%" align="right">*</span>
                    </lable>
                    @Html.EditorFor(model => model.name, new { htmlAttributes = new { @class = "form-control", id = "txt_name", onkeydown = "enter_to_tab2('txt_family');" } })
                    @Html.ValidationMessageFor(model => model.name, "", new { @class = "text-danger" })

