                @Html.ActionLink("خروج", "../home/main_pageFS", null, htmlAttributes: new { @class = "btn btn-cancel", style = "width:100%;", id = "btn_cancel", onkeydown = "enter_to_tab('txt_name');" })
            </div>
        </div>

    </div>
}
<script src="~/Content/assets/js/script-upload.js"></script>

<script type="text/jscript">
    window.onmouseover = function () {
        jalali_to_gregorian('birth_date_shamsi', 'txt_birth_date_miladi');
        set_age_param();
    }
    window.onload = function ()
    {
        if ('@ViewData["name"]' != '') { document.getElementById("txt_name").disabled = true; }
        if ('@ViewData["family"]' != '') { document.getElementById("txt_family").disabled = true; }
        if ('@ViewData["international_id"]' != '') { document.getElementById("txt_international_id").disabled = true; }
        if (document.getElementById("birth_date_shamsi").value != '')
        {
            set_age_param();
        }
        var test = '@Session["selectsoccer"]';
       if (test != '') {
            //document.getElementById('cmb_soccer').value = test;
            //$(".select2").select2();
           //set_data(1);
           @*alert('dd');
           '@{ 
               var temp = "";
               try
               {
                   temp = Model.pictuer;

               }
               catch
               {
                   temp = "";
               }
       }
           document.getElementById('doc_pic').src = '@temp';*@

       }
        var alarm = '@ViewBag.alarmText';
   //alert(alarm);
        if (alarm != '') {
            $('#view_person').show();
            $('#alaram_box').hide().fadeIn(1000);

        }
        else {
            $('#view_person').hide().fadeIn(1000);
            document.getElementById("hdn_alarm").value = "";
        }
        $(function () {
